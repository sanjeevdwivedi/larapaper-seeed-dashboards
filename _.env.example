# Copy this file to .env and fill in real values.
# docker-compose.yml reads these via ${APP_KEY} / ${APP_URL} substitution.

# Generate with: echo "base64:$(openssl rand -base64 32)"
APP_KEY=base64:REPLACE_ME

# LAN address this LXC is reachable at (no trailing slash)
APP_URL=http://192.168.24.63:4567
